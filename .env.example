# Kopieren nach .env.local und Werte setzen
#
# Optional: Startseite/Login/Registrierung nutzen public/images/americandragon.jpg
# (Datei dort ablegen, falls du den Hintergrund willst)

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Mindestens 32 Zeichen in Production (openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Muss mit BETTER_AUTH_URL übereinstimmen (lokal meist localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, bei Cookie-Problemen hinter Proxy:
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# UploadThing Dashboard
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=
